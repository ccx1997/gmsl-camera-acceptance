    {"bus": 32, "address": 72, "csi_port": 2, "device": "/dev/max9296_c", "power": "/sys/class/tz_gpio/camera_4_5-power/value"},
    {"bus": 33, "address": 104, "csi_port": 3, "device": "/dev/max9296_d", "power": "/sys/class/tz_gpio/camera_6_7-power/value"}
  ]
